# Development example; replace values for your own environment.
ENVIRONMENT=development
DATABASE_URL=postgresql://pfmea_app:replace-locally@localhost:5432/pfmea_dev
SECRET_KEY=replace-with-a-long-random-secret-before-use
DEBUG=false
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; when set, this takes precedence over ALLOWED_ORIGINS.
BACKEND_CORS_ORIGINS=
RESEND_API_KEY=
